DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=journal_app
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-strong-32-plus-character-secret
# Optional key rotation support:
# - Keep JWT_SECRET set to the legacy signing key during rollout so old no-kid tokens still verify.
# - JWT_KEYS uses a comma-separated list of kid:secret entries.
# - JWT_ACTIVE_KID selects which JWT_KEYS entry signs newly issued tokens.
# Example rollover values:
# JWT_SECRET=old-signing-secret-kept-during-migration-at-least-32-chars
# JWT_ACTIVE_KID=2026-04
# JWT_KEYS=2026-04:new-signing-secret-at-least-32-chars,2026-03:old-signing-secret-kept-during-migration-at-least-32-chars
JWT_ACTIVE_KID=
JWT_KEYS=
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
DEBUG_COOKIES_ENABLED=false
MAX_REQUEST_BODY_BYTES=1048576
COOKIE_DOMAIN_ALLOWLIST=example.com,.example.com
LOCALHOST_DEV_COOKIES=false
DEBUGLOGS=false
INITIAL_ADMIN_EMAIL=email@example.com
INITIAL_ADMIN_PASSWORD=strongadminpass
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
