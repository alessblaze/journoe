DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=journal_app
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-strong-32-plus-character-secret
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
DEBUG_COOKIES_ENABLED=false
MAX_REQUEST_BODY_BYTES=1048576
COOKIE_DOMAIN_ALLOWLIST=example.com,.example.com
LOCALHOST_DEV_COOKIES=false
DEBUGLOGS=false
INITIAL_ADMIN_EMAIL=email@example.com
INITIAL_ADMIN_PASSWORD=strongadminpass
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
