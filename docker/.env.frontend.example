# Frontend Build-Time Environment Variables
# These are baked into the static bundle at `docker compose up --build` time.
# Copy this file to .env.frontend and fill in your values.

# URL of the backend API as seen by the browser.
# Set to /api when using the bundled nginx reverse proxy (default).
# Change to an absolute URL only if your frontend and backend are on different origins.
VITE_API_URL=/api

# Cloudflare Turnstile site key (public key — safe to expose).
# Get yours from https://dash.cloudflare.com/
# The value below is Cloudflare's official always-pass testing key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The hostname your frontend is served on (used by Vite's allowed hosts check).
# VITE_ALLOWED_HOSTS=your-domain.example.com
