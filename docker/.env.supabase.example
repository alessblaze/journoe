# Supabase Database Connection Details
# Find these in your Supabase project settings -> Database -> Connection string -> URI
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_NAME=postgres
DB_SSLMODE=require

# Application Settings
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional rollover example:
# JWT_SECRET=supabase-old-signing-secret-at-least-32-chars
# JWT_ACTIVE_KID=2026-04
# JWT_KEYS=2026-04:supabase-new-signing-secret-at-least-32-chars,2026-03:supabase-old-signing-secret-at-least-32-chars
JWT_ACTIVE_KID=
JWT_KEYS=
COOKIE_DOMAIN_ALLOWLIST=
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY
MAX_REQUEST_BODY_BYTES=1048576
LOCALHOST_DEV_COOKIES=true
DEBUGLOGS=false
